; =============================================================================
; 废土绝境系统 (Desolation System) 运行时全局配置文件
; 修改本文件后，在游戏内按【F10】即可热重载生效，无需重新编译或重启游戏！
; =============================================================================

[Settings]
; 作用域模式: 0 = 全局模式, 1 = 仅玩家生效, 2 = 仅NPC生效
TargetScope=0

; 攻速上限倍率 (支持浮点数，如 1.2, 2.4, 3.6, 4.8, 9.6)
AttackSpeedCap=4.8

; 四大极境天道总开关: 1 = 开启, 0 = 关闭
EnableAscension=1

[Thresholds]
; 基础宗师门槛等级 (原版默认 60.0)
MasteryThreshold=60.0

; 力量压制判定差值 (原版默认 30.0)
StrengthGapThreshold=30.0

; 反震伤害系数 (每差10点力量造成的反震伤害)
RecoilDamagePer10=5.0

; 绝对防御格挡门槛 (原版默认 105.0)
DefenseMastery=105.0

; 弹反/截击门槛 (原版默认 100.0)
CounterThreshold=100.0

; 霸体所需力量门槛 (原版默认 85.0)
HyperArmorStrReq=85.0

; 震荡波所需力量门槛 (原版默认 120.0)
ShockwaveStrReq=120.0

; 妙手空空贴身交互最大距离 (引擎空间尺度单位，默认 35.0)
PickpocketMaxDist=35.0

[Synergy]
; 万能钥匙协同门槛: 开锁 / 建筑 / 科学
MasterKeyLock=80.0
MasterKeyEng=80.0
MasterKeySci=80.0

; 静谧之触协同门槛: 潜行 / 暗杀
SilentStealth=80.0
SilentAssassin=80.0

; 妙手空空协同门槛: 潜行 / 偷窃
PickpocketStealth=80.0
PickpocketThieving=80.0

; 搬运宗师协同门槛: 劳作 / 建筑
TitanLabour=70.0
TitanEng=70.0

; 战地灵粮协同门槛: 农业 / 烹饪
ChefFarm=70.0
ChefCook=70.0

; 仿生义肢调校协同门槛: 医疗 / 科学
CyberMedic=80.0
CyberSci=80.0

; =============================================================================
; [Hooks] 逐 Hook 灰度开关 (P2 治理)
; key = hook 函数名; 0 = 禁用该机制 (默认全部启用; 无此段 = 全部启用)
; 用途: 灰度排障 / A-B 验证某机制是否生效 (配合回归手册)
; 完整 key 清单与机制对照: docs/14_游戏内回归测试手册.md 总表
; 生效时机: 插件注册阶段 -> 修改后需重启游戏 (F10 只热重载数值, 不影响已注册 Hook)
; =============================================================================
[Hooks]
; 示例 (按需取消注释后重启游戏):
; getStat_hook=0                     ; 濒死回光返照 (躯干<=20% 全属性+50%)
; calculateAttackOrBlockSpeed_hook=0 ; 攻速上限突破 / 武术攻速 / 田径加成
; applyDamage_hook=0                 ; 要害减伤 / 肉身成圣 10% 全域免伤
; periodicUpdate_hook=0              ; 肢体锁血保底 / 血液 50% 锁定 / 义肢自修
; getHit_hook=0                      ; 受击结算总闸 (霸体/太刀放血/震荡波/EMP致瘫/真伤)
; blockHit_hook=0                    ; 力量反震 / 防御反伤
; gwMainLoop_hook=0                  ; 主循环总闸 (F6/F8/9+0/F10/V/机械至尊背负收编)
; setCrime_hook=0                    ; 零通缉阻断 (静谧之触/幽冥主宰)
